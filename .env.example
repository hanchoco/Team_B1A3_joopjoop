# 루트 docker-compose.yml이 `db` 컨테이너를 띄울 때 쓰는 값입니다.
# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요 (.env는 git에 커밋되지 않습니다).
#
# backend 컨테이너 자체의 환경변수(DATABASE_URL, SECRET_KEY, UPSTAGE_API_KEY 등)는
# backend/.env.example을 참고해서 backend/.env에 별도로 설정하세요.
# 특히 backend/.env의 DATABASE_URL은 아래 값들과 일치해야 합니다:
#   DATABASE_URL=mysql+pymysql://joopjoop:<MYSQL_PASSWORD와 동일한 값>@db:3306/joopjoop?charset=utf8mb4

MYSQL_DATABASE=joopjoop
MYSQL_USER=joopjoop
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
