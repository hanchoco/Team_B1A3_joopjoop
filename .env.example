# Add shared environment variables here.

# SMTP (관심 정책 마감 알림 이메일 발송, 선택 — 미설정 시 발송을 건너뜀)
# Gmail 사용 시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=본인 Gmail 주소, SMTP_PASSWORD=Google 계정의 앱 비밀번호(일반 로그인 비밀번호 아님)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=
