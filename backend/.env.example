APP_NAME=joopjoop API
API_V1_PREFIX=/api/v1
DEBUG=false

# Local development fallback:
DATABASE_URL=sqlite:///./joopjoop.db
# Docker/MySQL example:
# DATABASE_URL=mysql+pymysql://joopjoop:change-me@db:3306/joopjoop?charset=utf8mb4

SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional integrations. Never commit real values.
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_SOLAR_MODEL=solar-pro3
YOUTH_POLICY_API_KEY=
YOUTH_POLICY_API_URL=https://www.youthcenter.go.kr/opi/youthPlcyList.do
