APP_NAME=joopjoop API
API_V1_PREFIX=/api/v1
DEBUG=false

# Local MySQL development:
DATABASE_URL=mysql+pymysql://joopjoop_app:YOUR_PASSWORD@127.0.0.1:3306/joopjoop?charset=utf8mb4

# Optional SQLite fallback:
# DATABASE_URL=sqlite:///./joopjoop.db

# Docker Compose example. Use after adding a service named "db":
# DATABASE_URL=mysql+pymysql://joopjoop_app:YOUR_PASSWORD@db:3306/joopjoop?charset=utf8mb4

SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTO_CREATE_TABLES=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional integrations. Never commit real values.
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_SOLAR_MODEL=solar-pro3
YOUTH_POLICY_API_KEY=
YOUTH_POLICY_API_URL=https://www.youthcenter.go.kr/opi/youthPlcyList.do

# SMTP (관심 정책 마감 알림 이메일 발송, 선택 — 미설정 시 발송을 건너뛰고 PENDING으로 남음)
# Gmail 사용 시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=본인 Gmail 주소, SMTP_PASSWORD=Google 계정의 앱 비밀번호(일반 로그인 비밀번호 아님)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=
